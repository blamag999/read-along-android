{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://read-along-admin.pages.dev/schemas/analytics-event.schema.json",
  "title": "Read Along anonymous reading/listening session event",
  "description": "Proposed v1 contract. The client sends events only after explicit analytics opt-in. Do not include names, filenames, document content, media URLs, tokens, cookies or personal identifiers.",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "sessionId",
    "installId",
    "sequence",
    "type",
    "occurredAt",
    "platform",
    "appVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,100}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,100}$"
    },
    "installId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,100}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "reader_start",
        "heartbeat",
        "reader_pause",
        "reader_resume",
        "reader_stop",
        "audio_play",
        "audio_pause",
        "audio_stop"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "readingSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "listeningSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "platform": {
      "enum": [
        "android",
        "web"
      ]
    },
    "appVersion": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+-]{1,40}$"
    },
    "bookId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,160}$",
      "description": "Opaque catalog book ID only; never a title, filename, path or URL."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "heartbeat"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "readingSeconds"
            ]
          },
          {
            "required": [
              "listeningSeconds"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "reader_pause"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "readingSeconds"
            ]
          },
          {
            "required": [
              "listeningSeconds"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "reader_stop"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "readingSeconds"
            ]
          },
          {
            "required": [
              "listeningSeconds"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "audio_pause"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "listeningSeconds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "audio_stop"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "listeningSeconds"
        ]
      }
    }
  ]
}
